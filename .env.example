# Sanity — laisse vide tant que le projet n'est pas créé : le site retombe
# alors automatiquement sur les projets locaux (src/lib/projects.js).
# Récupère l'ID sur sanity.io/manage, puis ajoute-le AUSSI dans Vercel
# (Settings > Environment Variables) pour que la production le voie.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
